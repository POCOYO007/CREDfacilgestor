rules_version = '2';

// =====================================================================
// Meu Jurista / CredFácil — regras do Firestore
//
// Papéis:
//  - master: users/{uid}.role == 'master' (dono do SaaS)
//  - admin (gestor) de um tenant: users/{uid} com role 'admin' + tenantId,
//    OU documento em tenants/{t}/admins/{uid},
//    OU e-mail VERIFICADO igual ao tenants/{t}.adminEmail
//  - cobrador: users/{uid} com role 'cobrador' + tenantId + cobradorId,
//    e o documento do cobrador precisa estar ativo.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }

    function isMaster() { return hasUser() && me().role == 'master'; }

    function tenantPath(t) { return /databases/$(database)/documents/tenants/$(t); }

    function isAdmin(t) {
      return signedIn() && (
        isMaster()
        || (hasUser() && me().role == 'admin' && me().tenantId == t)
        || exists(/databases/$(database)/documents/tenants/$(t)/admins/$(request.auth.uid))
        || (verified() && exists(tenantPath(t)) && get(tenantPath(t)).data.get('adminEmail', '') == request.auth.token.email)
      );
    }

    function isCobrador(t) {
      return hasUser() && me().role == 'cobrador' && me().tenantId == t
        && me().get('cobradorId', '') is string && me().cobradorId != ''
        && exists(/databases/$(database)/documents/tenants/$(t)/cobradores/$(me().cobradorId))
        && get(/databases/$(database)/documents/tenants/$(t)/cobradores/$(me().cobradorId)).data.get('ativo', true) != false;
    }

    function isMember(t) { return isAdmin(t) || isCobrador(t); }
    function myCobradorId() { return me().cobradorId; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changed() { return incoming().diff(existing()).affectedKeys(); }

    // ---------------- validações ----------------
    function isValidCliente(d) {
      return d.nome is string && d.nome.size() > 0 && d.nome.size() < 256
        && (d.get('cpfCnpj', null) == null || (d.cpfCnpj is string && d.cpfCnpj.size() < 20))
        && d.criadoEm is string;
    }

    function isValidEmprestimo(d) {
      return d.clienteId is string && isValidId(d.clienteId)
        && d.valorPrincipal is number && d.valorPrincipal >= 0
        && d.status is string
        && d.criadoEm is string;
    }

    function isValidRecebimento(d) {
      return d.emprestimoId is string && isValidId(d.emprestimoId)
        && d.valor is number && d.valor > 0 && d.valor < 10000000
        && d.tipo in ['regular', 'quitacao', 'somente_juros', 'multa']
        && d.criadoEm is string
        && (d.get('observacao', '') is string && d.get('observacao', '').size() < 1000);
    }

    function isValidPagamentoCobrador(d) {
      return d.cobradorId is string && isValidId(d.cobradorId)
        && d.valor is number && d.valor != 0
        && d.periodo is string
        && d.criadoEm is string;
    }

    function isValidDespesa(d) {
      return d.valor is number && d.valor > 0 && d.valor < 1000000
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() < 500
        && d.data is string
        && d.criadoEm is string;
    }

    function isValidTenant(d) {
      return d.nome is string && d.nome.size() > 0 && d.nome.size() < 256
        && (d.get('adminEmail', null) == null || (d.adminEmail is string && d.adminEmail.size() > 0))
        && d.plano in ['Básico', 'Pro', 'Enterprise']
        && d.status in ['ativo', 'congelado', 'suspenso']
        && d.vencimento is string;
    }

    // ---------------- padrão: nega tudo ----------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------- vínculo usuário → empresa ----------------
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isMaster());

      // Auto-cadastro do cobrador no primeiro login. Só vale se existir um
      // cobrador naquela empresa amarrado a ESTE login: pelo uid (conta
      // usuário/senha criada pelo gestor) ou pelo e-mail VERIFICADO (Google).
      allow create: if signedIn() && request.auth.uid == userId
        && incoming().keys().hasOnly(['email', 'tenantId', 'role', 'cobradorId'])
        && incoming().role == 'cobrador'
        && incoming().tenantId is string && isValidId(incoming().tenantId)
        && incoming().cobradorId is string && isValidId(incoming().cobradorId)
        && (
          get(/databases/$(database)/documents/tenants/$(incoming().tenantId)/cobradores/$(incoming().cobradorId)).data.get('authUid', '') == request.auth.uid
          || (verified() && get(/databases/$(database)/documents/tenants/$(incoming().tenantId)/cobradores/$(incoming().cobradorId)).data.get('email', '') == request.auth.token.email)
        );

      allow create, update, delete: if isMaster();
    }

    // Busca do próprio cadastro de cobrador no login (antes de saber a empresa).
    // A consulta precisa filtrar pelo PRÓPRIO uid/e-mail — não dá para listar os outros.
    match /{path=**}/cobradores/{cobradorId} {
      allow read: if signedIn() && (
        resource.data.get('authUid', '') == request.auth.uid
        || (verified() && resource.data.get('email', '') == request.auth.token.email)
      );
    }

    // ---------------- empresas ----------------
    match /tenants/{tenantId} {
      // Busca da empresa pelo e-mail do gestor no login: só a própria.
      allow list: if isMaster() || (verified() && resource.data.get('adminEmail', '') == request.auth.token.email);
      allow get: if isMaster() || isMember(tenantId);
      allow create, update: if isMaster() && isValidTenant(incoming());
      allow delete: if isMaster();

      match /admins/{uid} {
        allow read: if isAdmin(tenantId);
        allow write: if isMaster();
      }

      // Clientes
      match /clientes/{clienteId} {
        allow read: if isMember(tenantId);
        allow create: if isMember(tenantId) && isValidCliente(incoming())
          && incoming().keys().hasAll(['nome', 'criadoEm'])
          && incoming().keys().size() <= 12;
        allow update: if isMember(tenantId) && isValidCliente(incoming())
          && changed().hasOnly(['nome', 'cpfCnpj', 'telefone', 'whatsapp', 'endereco', 'observacao']);
        allow delete: if isAdmin(tenantId);
      }

      // Contratos
      match /emprestimos/{emprestimoId} {
        allow read: if isMember(tenantId);

        allow create: if isMember(tenantId) && isValidEmprestimo(incoming())
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/clientes/$(incoming().clienteId))
          && (isAdmin(tenantId) || incoming().get('cobradorId', '') == myCobradorId());

        // Gestor: pode tudo (inclusive "Editar contrato").
        // Cobrador: só pode mexer no contrato JUNTO com o recebimento que
        // está criando na mesma gravação, e o saldo não pode cair mais do
        // que o valor recebido. Assim ninguém zera dívida "na mão".
        allow update: if isAdmin(tenantId) || (
          isCobrador(tenantId)
          && changed().hasOnly([
            'status', 'saldoDevedor', 'valorPrincipal', 'valorParcela', 'parcelasPagas', 'dataVencimento',
            'multaAcumulada', 'multaAbatida', 'abatimentoJuros', 'pagoParcelaAtual', 'acrescimoProximo',
            'ultimoRecebimentoId'
          ])
          && incoming().valorPrincipal is number && incoming().valorPrincipal >= 0
          && incoming().get('saldoDevedor', 0) is number && incoming().get('saldoDevedor', 0) >= 0
          && incoming().get('multaAcumulada', 0) is number && incoming().get('multaAcumulada', 0) >= 0
          && incoming().ultimoRecebimentoId is string && isValidId(incoming().ultimoRecebimentoId)
          && !exists(/databases/$(database)/documents/tenants/$(tenantId)/recebimentos/$(incoming().ultimoRecebimentoId))
          && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/recebimentos/$(incoming().ultimoRecebimentoId)).data.emprestimoId == emprestimoId
          && getAfter(/databases/$(database)/documents/tenants/$(tenantId)/recebimentos/$(incoming().ultimoRecebimentoId)).data.cobradorId == myCobradorId()
          && existing().valorPrincipal - incoming().valorPrincipal
               <= getAfter(/databases/$(database)/documents/tenants/$(tenantId)/recebimentos/$(incoming().ultimoRecebimentoId)).data.valor + 0.01
        );

        allow delete: if isAdmin(tenantId);
      }

      // Recebimentos
      match /recebimentos/{recebimentoId} {
        allow read: if isMember(tenantId);
        allow create: if isMember(tenantId) && isValidRecebimento(incoming())
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/emprestimos/$(incoming().emprestimoId))
          && (isAdmin(tenantId) || incoming().get('cobradorId', '') == myCobradorId());
        allow delete: if isAdmin(tenantId);
      }

      // Cobradores (equipe)
      match /cobradores/{cobradorId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      // Despesas
      match /despesas/{despesaId} {
        allow read: if isMember(tenantId);
        allow create: if isMember(tenantId) && isValidDespesa(incoming())
          && (isAdmin(tenantId) || (
            incoming().get('cobradorId', '') == myCobradorId()
            && incoming().get('aprovada', null) == null
          ));
        allow update, delete: if isAdmin(tenantId);
      }

      // Repasses ao cobrador — só o gestor lança.
      match /pagamentosCobradores/{pagamentoId} {
        allow read: if isMember(tenantId);
        allow create: if isAdmin(tenantId) && isValidPagamentoCobrador(incoming());
        allow update, delete: if isAdmin(tenantId);
      }

      // Configurações
      match /config/{configId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }
    }
  }
}
