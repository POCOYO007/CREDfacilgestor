# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_MASTER_EMAIL: Fallback used only on first login of the master account,
# before a users/{uid} doc with role "master" exists in Firestore. Optional —
# once that doc is created (manually, via Firebase Console/Admin SDK), the
# role check in firestore.rules and App.tsx step 1 takes over and this is no
# longer read. Leave unset in tenants that don't need this bootstrap path.
VITE_MASTER_EMAIL=""

# VITE_RECAPTCHA_SITE_KEY: reCAPTCHA v3 site key used by Firebase App Check
# to prove Firestore/Auth requests come from this site (not a script hitting
# the API directly with the same public Firebase config). Create it at
# https://www.google.com/recaptcha/admin/create (type: reCAPTCHA v3), then
# register the matching secret key in Firebase Console > App Check.
VITE_RECAPTCHA_SITE_KEY=""
